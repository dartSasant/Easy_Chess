{
  "expo": {
    "name": "EasyChess",
    "slug": "easychess",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "easychess",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.createforlangtang.easychess",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.createforlangtang.easychess",
      "adaptiveIcon": {
        "backgroundColor": "#2A7A6C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A7A6C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-ble-kit",
        {
          "android": {
            "advertise": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
